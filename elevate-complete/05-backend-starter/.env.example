# ============================================================================
# Elevate Dental OS · Environment Variables
# Copy to .env and fill in real values · DO NOT commit .env to source control
# ============================================================================

# --- Core ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
BASE_URL=http://localhost:4000

# --- Postgres ---
DATABASE_URL=postgres://elevate:elevate_dev@localhost:5432/elevate
DATABASE_POOL_MAX=20

# --- Redis (jobs + sessions) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me-to-a-random-64-byte-hex-string
SESSION_COOKIE_NAME=elevate_session
SESSION_TTL_MINUTES=30
MFA_ISSUER=Elevate Dental OS

# --- Secrets manager (envelope encryption of integration tokens) ---
# Production: use AWS_KMS_KEY_ID, AZURE_KEY_VAULT_URL, or GCP_KMS_KEY
# Development: use a local 32-byte hex key (NEVER in production)
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# --- Dentally ---
DENTALLY_BASE_URL=https://api.sandbox.dentally.co
# Per-integration API key stored in secrets manager · not env

# --- Xero ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:4000/v1/integrations/xero/callback
XERO_WEBHOOK_KEY=

# --- QuickBooks ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:4000/v1/integrations/quickbooks/callback
QBO_WEBHOOK_VERIFIER=
QBO_ENVIRONMENT=sandbox

# --- GoHighLevel ---
# API keys are per-integration · stored in secrets manager

# --- Stripe ---
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- TrueLayer (Open Banking) ---
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:4000/v1/integrations/open_banking/callback
TRUELAYER_ENVIRONMENT=sandbox

# --- Frontend ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# --- Observability ---
SENTRY_DSN=
