{
  "name": "@elevate/api",
  "version": "1.0.0",
  "description": "Elevate Dental OS — Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "typecheck": "find src -name '*.js' -exec node --check {} +",
    "build": "echo 'no build: backend is native ESM'",
    "lint": "eslint src --ext .js",
    "data-room:dictionary": "node scripts/data-room-dictionary.js",
    "migrate": "node ../scripts/migrate.js",
    "seed": "node ../scripts/seed-tenant.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sesv2": "^3.1063.0",
    "@aws-sdk/client-sns": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@sentry/node": "^10.53.1",
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "openai": "^6.42.0",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "pino-roll": "^4.0.0",
    "postmark": "^4.0.4",
    "stripe": "^16.7.0",
    "twilio": "^5.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "pino-pretty": "^13.1.3",
    "vitest": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
