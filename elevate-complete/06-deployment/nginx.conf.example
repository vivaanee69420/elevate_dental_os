# nginx reverse proxy for Elevate Dental OS
# Place this file at /etc/nginx/sites-available/elevate and symlink to sites-enabled

upstream elevate_api {
    least_conn;
    server 127.0.0.1:4000;
    # Add more upstream servers for HA:
    # server 10.0.1.5:4000;
    # server 10.0.1.6:4000;
    keepalive 32;
}

# Redirect all HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name api.elevateos.co app.elevateos.co;
    return 301 https://$host$request_uri;
}

# API (api.elevateos.co)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.elevateos.co;

    ssl_certificate     /etc/letsencrypt/live/api.elevateos.co/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.elevateos.co/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Logs
    access_log /var/log/nginx/elevate-api.access.log;
    error_log  /var/log/nginx/elevate-api.error.log warn;

    # Body size limit (uploads)
    client_max_body_size 10M;
    client_body_timeout 60s;

    # Webhook endpoints get longer timeout (upstream may be slow under load)
    location /v1/webhooks/ {
        proxy_pass http://elevate_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_request_buffering off;
    }

    # All other API routes
    location / {
        proxy_pass http://elevate_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }

    # Health endpoint (allow without auth, useful for load balancer probes)
    location = /health {
        proxy_pass http://elevate_api/health;
        access_log off;
    }
}

# Frontend (app.elevateos.co — serves the single-file HTML)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.elevateos.co;

    ssl_certificate     /etc/letsencrypt/live/app.elevateos.co/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.elevateos.co/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;

    root /var/www/elevate;
    index elevate-dental-os.html;

    location / {
        try_files $uri $uri/ /elevate-dental-os.html;
    }

    # Gzip the big HTML file
    gzip on;
    gzip_types text/html text/css application/javascript;
    gzip_min_length 1024;
}
